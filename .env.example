# Copy to .env. Empty cloud credentials allow local UI/health/mock tests only.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend only: never put these secrets in VITE_* variables.
GEMINI_API_KEY=
# Matches backend settings; TV5 confirms availability with the real account.
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser configuration for TV1's auth integration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10
BACKEND_PORT=8000
FRONTEND_PORT=3000
# For another checkout choose a unique name AND different ports above.
# COMPOSE_PROJECT_NAME=exam-tam
