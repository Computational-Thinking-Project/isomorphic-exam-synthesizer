# ==============================================================================
# Isomorphic Exam Synthesizer - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- APPLICATION SETTINGS ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- GEMINI AI SERVICE (AI-01) ---
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Selected stable API model.
GEMINI_MODEL=gemini-3.5-flash-lite
BLUEPRINT_MODEL=gemini-3.5-flash-lite

# --- SUPABASE DATABASE & AUTH (SEC-01) ---
SUPABASE_URL=https://your-project.supabase.co
# Anon / Public Key for frontend client authentication
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key (PRIVILEGED - NEVER expose to frontend or log in production)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- SECURITY & CORS (SEC-05, SEC-06) ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Maximum file upload size in MB (Stage 1 Document Ingestion)
MAX_UPLOAD_SIZE_MB=10

# --- PORT CONFIGURATIONS ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
