# Copy to .env. Empty cloud credentials allow local UI/health/mock tests only.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend only: never put these secrets in VITE_* variables.
GEMINI_API_KEY=
# Optional pool: each Gemini request randomly selects one distinct non-empty key.
# Keys in the same Google project share rate limits. Keep all values backend-only.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Matches backend settings; TV5 confirms availability with the real account.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CONCURRENCY=3
GEMINI_REQUEST_TIMEOUT_SECONDS=120
GEMINI_KEY_COOLDOWN_SECONDS=30
BLUEPRINT_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser configuration for TV1's auth integration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10
BACKEND_PORT=8000
FRONTEND_PORT=3000
# For another checkout choose a unique name AND different ports above.
# COMPOSE_PROJECT_NAME=exam-tam
